# Required. Generate the hash with: npm run hash-passphrase
# Keep the single quotes, because the hash contains $.
WS_PASSPHRASE_HASH=''
# Required for the ww command and hooks. Generate with: openssl rand -hex 24
WS_API_TOKEN=

# AI features are off until you choose a provider: none, anthropic, deepseek or ollama.
# With a provider, every feature switched on in Settings sends your text to it. All are on by default.
WS_LLM_PROVIDER=none
# WS_ANTHROPIC_API_KEY=
# WS_ANTHROPIC_WORKSPACE_ID=
# WS_DEEPSEEK_API_KEY=
# WS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# WS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# WS_MODEL_FAST=
# WS_MODEL_JUDGE=
# WS_PRICE_FAST=0.22/0.66
# WS_PRICE_JUDGE=0.22/0.66

# Where the database lives in development. Docker uses /data.
WS_DATA_DIR=./data

# Docker: the local port, the public URL of the app, your time zone, and the user that owns ./data.
# WS_PORT=3000
# WS_ORIGIN=http://127.0.0.1:3000
# TZ=UTC
# WS_UID=1000
# WS_GID=1000

# Optional personalisation.
# WS_DISPLAY_NAME=
# WS_LEARNER_PROFILE=someone who writes in English and European Portuguese
# WS_ALLOWED_HOSTS=

# Optional integrations, off when unset. See the README before enabling them.
# WS_CLAUDE_PROJECTS_DIR=
# WS_JOURNAL_DIR=
# WS_JOURNAL_LINK_PREFIX=
